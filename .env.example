# Copy this file to .env (at the repo root) and fill in the three keys. .env is ignored by git.
# Never commit real keys. The website's server reads them; they never reach the browser.

# ElevenLabs: Scribe speech-to-text (batch and realtime) and the spoken replies.
# The key needs Speech to Text and Text to Speech access.
ELEVENLABS_API_KEY=

# OpenRouter: Gemini Flash, which hears each clip after seeing a few of the person's own.
OPENROUTER_API_KEY=

# Anthropic: Claude Haiku 5.5, which repairs the reading and picks the pretend-phone action.
ANTHROPIC_API_KEY=

# --- Optional ---
# The ElevenLabs voice the assistant speaks in. Empty uses a default voice.
# ELEVENLABS_VOICE_ID=
# Only behind a proxy you trust (for example Cloudflare): take the visitor's address from its
# header for the per-visitor limit. Leave unset when running locally.
# TRUST_PROXY=1
# Optional: a keyword that locks the paid API routes, for sharing a public demo link. Visitors
# enter it once on the page. Leave unset to run unlocked on your own computer.
# ACCESS_KEY=
