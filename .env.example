# Copy to .env and fill in. .env is gitignored. Never commit real keys.

# ElevenLabs: voice (speech-to-text, the conversation agent, text-to-speech).
# Needs a key that can read/write Agents (Conversational AI).
ELEVENLABS_API_KEY=
# Filled in by the setup script once the agent is created.
ELEVENLABS_AGENT_ID=

# Anthropic: Claude plans and runs the multi-step tasks (browser-use and the Mac app loop).
ANTHROPIC_API_KEY=

# OpenRouter: access to Jev, the fast classifier (cancel / safety / web-vs-native).
# Without it the app still runs and uses keyword rules instead.
OPENROUTER_API_KEY=

# Optional overrides. The defaults are in src/voicelaptop/config.py.
# JEV_MODEL=jev-latest
# TASK_MODEL=claude-sonnet-5-5
# SMALL_MODEL=claude-haiku-5-5
# MAX_TASK_STEPS=25
# MAX_TASK_SECONDS=180

# Chrome profile the web tasks drive: "Default" or "Profile 1".
CHROME_PROFILE=Default

# Safe targets for real end-to-end tests. Tests never send to anyone else.
TEST_WHATSAPP_CONTACT=
TEST_INVITE_EMAIL=
